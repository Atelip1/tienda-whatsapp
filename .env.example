# Copia este archivo como .env.local y completa los valores de tu proyecto de Supabase.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Subdominio del panel (solo en producción). Ejemplo: admin.marianestarez.pe
# Déjalo vacío en tu computadora: el panel se abre en http://localhost:3000/admin
ADMIN_HOST=

# Opcional: URL del logo (PNG o SVG con fondo transparente). Vacío = espacio reservado.
NEXT_PUBLIC_LOGO_URL=
